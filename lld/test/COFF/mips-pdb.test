# RUN: yaml2obj %s -o %t.obj
# RUN: lld-link /debug /pdb:%t.pdb /out:%t.exe /entry:main \
# RUN:   /subsystem:native /machine:mips %t.obj
# RUN: llvm-pdbutil dump -modi=1 -symbols %t.pdb | FileCheck %s

# CHECK: machine = mips

--- !COFF
header:
  Machine:         IMAGE_FILE_MACHINE_R4000
  Characteristics: []
sections:
  - Name:            .text
    Characteristics: [ IMAGE_SCN_CNT_CODE, IMAGE_SCN_MEM_EXECUTE, IMAGE_SCN_MEM_READ ]
    Alignment:       4
    SectionData:     0800E00300000000
symbols:
  - Name:            .text
    Value:           0
    SectionNumber:   1
    SimpleType:      IMAGE_SYM_TYPE_NULL
    ComplexType:     IMAGE_SYM_DTYPE_NULL
    StorageClass:    IMAGE_SYM_CLASS_STATIC
    SectionDefinition:
      Length:          8
      NumberOfRelocations: 0
      NumberOfLinenumbers: 0
      CheckSum:        0
      Number:          1
  - Name:            main
    Value:           0
    SectionNumber:   1
    SimpleType:      IMAGE_SYM_TYPE_NULL
    ComplexType:     IMAGE_SYM_DTYPE_FUNCTION
    StorageClass:    IMAGE_SYM_CLASS_EXTERNAL
...
