# REQUIRES: x86
# Test that .bss is not merged into .data when .data is marked shared.
# MSVC link.exe keeps .bss separate to prevent unexpected sharing across
# processes.

# RUN: yaml2obj %s -o %t.obj

## Follow the merge chain and keep .bss separate from its shared destination.
# RUN: lld-link /out:%t.dll /dll /entry:DllMain \
# RUN:   /merge:.data=.shared %t.obj
# RUN: llvm-readobj --sections %t.dll | FileCheck -check-prefix=SHARED-CHAIN %s

# SHARED-CHAIN: Name: .bss
# SHARED-CHAIN: Name: .shared

## Explicitly retaining the shared attribute also keeps .bss separate.
# RUN: lld-link /out:%t2.dll /dll /entry:DllMain /section:.data,rws %t.obj
# RUN: llvm-readobj --sections %t2.dll | FileCheck -check-prefix=SHARED-OPTION %s

# SHARED-OPTION: Name: .bss
# SHARED-OPTION: Name: .data

## Omitting or negating the shared attribute permits the merge.
# RUN: lld-link /out:%t3.dll /dll /entry:DllMain /section:.data,rw %t.obj
# RUN: llvm-readobj --sections %t3.dll | FileCheck -check-prefix=OMITTED-S %s
# RUN: lld-link /out:%t4.dll /dll /entry:DllMain /section:.data,rw!s %t.obj
# RUN: llvm-readobj --sections %t4.dll | FileCheck -check-prefix=NEGATED-S %s
# RUN: lld-link /out:%t5.dll /dll /entry:DllMain /merge:.data=.shared \
# RUN:   /section:.shared,rw %t.obj
# RUN: llvm-readobj --sections %t5.dll | FileCheck -check-prefix=CHAIN-CLEARED %s

# OMITTED-S-NOT: Name: .bss
# OMITTED-S:     Name: .data
# NEGATED-S-NOT: Name: .bss
# NEGATED-S:     Name: .data
# CHAIN-CLEARED-NOT: Name: .bss
# CHAIN-CLEARED:     Name: .shared

--- !COFF
header:
  Machine:         IMAGE_FILE_MACHINE_AMD64
  Characteristics: [  ]
sections:
  - Name:            .text
    Characteristics: [ IMAGE_SCN_CNT_CODE, IMAGE_SCN_MEM_EXECUTE, IMAGE_SCN_MEM_READ ]
    Alignment:       4
    SectionData:     'C3'
    SizeOfRawData:   1
  - Name:            .data
    Characteristics: [ IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_READ, IMAGE_SCN_MEM_WRITE ]
    Alignment:       4
    SectionData:     '01000000'
    SizeOfRawData:   4
  - Name:            .shared
    Characteristics: [ IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_SHARED, IMAGE_SCN_MEM_READ, IMAGE_SCN_MEM_WRITE ]
    Alignment:       4
    SectionData:     '02000000'
    SizeOfRawData:   4
  - Name:            .bss
    Characteristics: [ IMAGE_SCN_CNT_UNINITIALIZED_DATA, IMAGE_SCN_MEM_READ, IMAGE_SCN_MEM_WRITE ]
    Alignment:       4
    SectionData:     ''
    SizeOfRawData:   256
symbols:
  - Name:            .text
    Value:           0
    SectionNumber:   1
    SimpleType:      IMAGE_SYM_TYPE_NULL
    ComplexType:     IMAGE_SYM_DTYPE_NULL
    StorageClass:    IMAGE_SYM_CLASS_STATIC
    SectionDefinition:
      Length:          1
      NumberOfRelocations: 0
      NumberOfLinenumbers: 0
      CheckSum:        0
      Number:          1
  - Name:            .data
    Value:           0
    SectionNumber:   2
    SimpleType:      IMAGE_SYM_TYPE_NULL
    ComplexType:     IMAGE_SYM_DTYPE_NULL
    StorageClass:    IMAGE_SYM_CLASS_STATIC
    SectionDefinition:
      Length:          4
      NumberOfRelocations: 0
      NumberOfLinenumbers: 0
      CheckSum:        0
      Number:          2
  - Name:            .bss
    Value:           0
    SectionNumber:   3
    SimpleType:      IMAGE_SYM_TYPE_NULL
    ComplexType:     IMAGE_SYM_DTYPE_NULL
    StorageClass:    IMAGE_SYM_CLASS_STATIC
    SectionDefinition:
      Length:          256
      NumberOfRelocations: 0
      NumberOfLinenumbers: 0
      CheckSum:        0
      Number:          3
  - Name:            DllMain
    Value:           0
    SectionNumber:   1
    SimpleType:      IMAGE_SYM_TYPE_NULL
    ComplexType:     IMAGE_SYM_DTYPE_FUNCTION
    StorageClass:    IMAGE_SYM_CLASS_EXTERNAL
...
