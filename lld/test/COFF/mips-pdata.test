# RUN: yaml2obj %s -o %t.obj
# RUN: lld-link /out:%t.exe /entry:main /subsystem:native /machine:mips \
# RUN:   /base:0x400000 %t.obj
# RUN: llvm-readobj --hex-dump=.pdata %t.exe | FileCheck %s
# RUN: yaml2obj %p/Inputs/machine-x86.yaml -o %t.x86.obj
# RUN: not lld-link /out:%t.exe /entry:main /subsystem:native /machine:mips \
# RUN:   %t.x86.obj 2>&1 | FileCheck %s --check-prefix=INCOMPAT

# CHECK: 0x{{0*}}402000 00100000 10100000 00000000 00000000
# CHECK: 0x{{0*}}402010 04100000 00300000 10300000 00000000
# CHECK: 0x{{0*}}402020 00000000 04300000
# INCOMPAT: machine type x86 conflicts with mips

--- !COFF
header:
  Machine:         IMAGE_FILE_MACHINE_R4000
  Characteristics: []
sections:
  - Name:            .text
    Characteristics: [ IMAGE_SCN_CNT_CODE, IMAGE_SCN_MEM_EXECUTE, IMAGE_SCN_MEM_READ ]
    Alignment:       4
    SectionData:     0800e003
  - Name:            .pdata
    Characteristics: [ IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_READ ]
    Alignment:       4
    SectionData:     00300000103000000000000000000000043000000010000010100000000000000000000004100000
symbols:
  - Name:            .text
    Value:           0
    SectionNumber:   1
    SimpleType:      IMAGE_SYM_TYPE_NULL
    ComplexType:     IMAGE_SYM_DTYPE_NULL
    StorageClass:    IMAGE_SYM_CLASS_STATIC
    SectionDefinition:
      Length:          4
      NumberOfRelocations: 0
      NumberOfLinenumbers: 0
      CheckSum:        0
      Number:          1
  - Name:            .pdata
    Value:           0
    SectionNumber:   2
    SimpleType:      IMAGE_SYM_TYPE_NULL
    ComplexType:     IMAGE_SYM_DTYPE_NULL
    StorageClass:    IMAGE_SYM_CLASS_STATIC
    SectionDefinition:
      Length:          40
      NumberOfRelocations: 0
      NumberOfLinenumbers: 0
      CheckSum:        0
      Number:          2
  - Name:            main
    Value:           0
    SectionNumber:   1
    SimpleType:      IMAGE_SYM_TYPE_NULL
    ComplexType:     IMAGE_SYM_DTYPE_NULL
    StorageClass:    IMAGE_SYM_CLASS_EXTERNAL
...
