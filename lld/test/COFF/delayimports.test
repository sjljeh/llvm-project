# RUN: lld-link /out:%t.exe /entry:main /subsystem:console \
# RUN:   %p/Inputs/hello64.obj %p/Inputs/std64.lib /delayload:STD64.DLL \
# RUN:   /alternatename:__delayLoadHelper2=main
# RUN: llvm-readobj --coff-imports %t.exe | FileCheck -check-prefix=IMPORT %s
# RUN: llvm-readobj --coff-basereloc %t.exe | FileCheck -check-prefix=BASEREL %s
# RUN: llvm-readobj --unwind %t.exe | FileCheck -check-prefix=UNWIND %s

# Like link.exe, list the imports with the first and last referenced ones
# swapped, give them their hints, add an (unbound) bound import table, put the
# import address table before the module handle and the tail-merge code before
# the thunks.
IMPORT:      DelayImport {
IMPORT-NEXT:   Name: std64.dll
IMPORT-NEXT:   Attributes: 0x1
IMPORT-NEXT:   ModuleHandle: 0x3038
IMPORT-NEXT:   ImportAddressTable: 0x3018
IMPORT-NEXT:   ImportNameTable: 0x2060
IMPORT-NEXT:   BoundDelayImportTable: 0x20A0
IMPORT-NEXT:   UnloadDelayImportTable: 0x0
IMPORT-NEXT:   Import {
IMPORT-NEXT:     Symbol:  (50)
IMPORT-NEXT:     Address: 0x1400010BC
IMPORT-NEXT:   }
IMPORT-NEXT:   Import {
IMPORT-NEXT:     Symbol: MessageBoxA (1)
IMPORT-NEXT:     Address: 0x1400010C8
IMPORT-NEXT:   }
IMPORT-NEXT:   Import {
IMPORT-NEXT:     Symbol: ExitProcess (0)
IMPORT-NEXT:     Address: 0x1400010D4
IMPORT-NEXT:   }
IMPORT-NEXT: }

BASEREL:      BaseReloc [
BASEREL-NEXT:   Entry {
BASEREL-NEXT:     Type: DIR64
BASEREL-NEXT:     Address: 0x3018
BASEREL-NEXT:   }
BASEREL-NEXT:   Entry {
BASEREL-NEXT:     Type: DIR64
BASEREL-NEXT:     Address: 0x3020
BASEREL-NEXT:   }
BASEREL-NEXT:   Entry {
BASEREL-NEXT:     Type: DIR64
BASEREL-NEXT:     Address: 0x3028
BASEREL-NEXT:   }

UNWIND:      UnwindInformation [
UNWIND-NEXT:   RuntimeFunction {
UNWIND-NEXT:     StartAddress: (0x140001045)
UNWIND-NEXT:     EndAddress: (0x1400010BC)
UNWIND-NEXT:     UnwindInfoAddress: (0x140002018)
UNWIND-NEXT:     UnwindInfo {
UNWIND-NEXT:       Version: 1
UNWIND-NEXT:       Flags [ (0x0)
UNWIND-NEXT:       ]
UNWIND-NEXT:       PrologSize: 24
UNWIND-NEXT:       FrameRegister: -
UNWIND-NEXT:       FrameOffset: -
UNWIND-NEXT:       UnwindCodeCount: 1
UNWIND-NEXT:       UnwindCodes [
UNWIND-NEXT:         0x18: ALLOC_SMALL size=104
UNWIND-NEXT:       ]
UNWIND-NEXT:     }
UNWIND-NEXT:   }
UNWIND-NEXT: ]
