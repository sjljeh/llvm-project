# RUN: yaml2obj %s -o %t.obj
# RUN: lld-link /machine:alpha /entry:entry /subsystem:native /nodefaultlib /gpsize:8 \
# RUN:   /out:%t.exe %t.obj
# RUN: llvm-readobj --file-headers --sections --hex-dump=.text \
# RUN:   --hex-dump=.sdata %t.exe | FileCheck %s

# Microsoft Alpha small-data relocations are relative to the quadword-aligned
# midpoint of the complete .sdata output range. Here .sdata occupies
# [0x4000, 0x4010), so GP is 0x4008 and both references to data become -8.

# CHECK:      GlobalPtrRVA: 0x4008
# CHECK-NEXT: GlobalPtrSize: 0x0
# CHECK:      Name: .text
# CHECK-NEXT: VirtualSize: 0x10
# CHECK:      Name: .sdata
# CHECK-NEXT: VirtualSize: 0x18
# CHECK:      Hex dump of section '.text':
# CHECK-NEXT: {{.*}} f8ff0000 f8ffffff 44332211 08000000
# CHECK:      Hex dump of section '.sdata':
# CHECK-NEXT: {{.*}} 00000000 00000000 00000000 00000000

--- !COFF
header:
  Machine:         IMAGE_FILE_MACHINE_ALPHA
  Characteristics: []
sections:
  - Name:            .text
    Characteristics: [ IMAGE_SCN_CNT_CODE, IMAGE_SCN_MEM_EXECUTE, IMAGE_SCN_MEM_READ ]
    Alignment:       4
    SectionData:     00000000000000004433221100000000
    Relocations:
      - VirtualAddress:  0
        SymbolName:      data
        Type:            IMAGE_REL_ALPHA_LITERAL
      - VirtualAddress:  4
        SymbolName:      data
        Type:            IMAGE_REL_ALPHA_GPREL32
      - VirtualAddress:  8
        SymbolName:      data
        Type:            IMAGE_REL_ALPHA_LITUSE
      - VirtualAddress:  12
        SymbolName:      small_common
        Type:            IMAGE_REL_ALPHA_LITERAL
  - Name:            .sdata
    Characteristics: [ IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_READ, IMAGE_SCN_MEM_WRITE ]
    Alignment:       8
    SectionData:     00000000000000000000000000000000
symbols:
  - Name:            entry
    Value:           0
    SectionNumber:   1
    SimpleType:      IMAGE_SYM_TYPE_NULL
    ComplexType:     IMAGE_SYM_DTYPE_FUNCTION
    StorageClass:    IMAGE_SYM_CLASS_EXTERNAL
  - Name:            data
    Value:           0
    SectionNumber:   2
    SimpleType:      IMAGE_SYM_TYPE_NULL
    ComplexType:     IMAGE_SYM_DTYPE_NULL
    StorageClass:    IMAGE_SYM_CLASS_EXTERNAL
  - Name:            small_common
    Value:           8
    SectionNumber:   0
    SimpleType:      IMAGE_SYM_TYPE_NULL
    ComplexType:     IMAGE_SYM_DTYPE_NULL
    StorageClass:    IMAGE_SYM_CLASS_EXTERNAL
...
