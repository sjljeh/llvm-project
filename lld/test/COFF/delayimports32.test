# REQUIRES: x86
# RUN: yaml2obj %p/Inputs/hello32.yaml -o %t.obj
# RUN: lld-link -safeseh:no %t.obj %p/Inputs/std32.lib /subsystem:console \
# RUN:   /entry:main@0 /alternatename:___delayLoadHelper2@8=_main@0 \
# RUN:   /delayload:std32.dll /out:%t.exe
# RUN: llvm-readobj --coff-imports %t.exe | FileCheck -check-prefix=IMPORT %s
# RUN: llvm-readobj --coff-basereloc %t.exe | FileCheck -check-prefix=BASEREL %s
# RUN: llvm-objdump --no-print-imm-hex -d %t.exe | FileCheck --check-prefix=DISASM %s

IMPORT:      Format: COFF-i386
IMPORT-NEXT: Arch: i386
IMPORT-NEXT: AddressSize: 32bit
IMPORT-NEXT: DelayImport {
IMPORT-NEXT:   Name: std32.dll
IMPORT-NEXT:   Attributes: 0x1
IMPORT-NEXT:   ModuleHandle: 0x3020
IMPORT-NEXT:   ImportAddressTable: 0x3014
IMPORT-NEXT:   ImportNameTable: 0x2058
IMPORT-NEXT:   BoundDelayImportTable: 0x2080
IMPORT-NEXT:   UnloadDelayImportTable: 0x0
IMPORT-NEXT:   Import {
IMPORT-NEXT:     Symbol: MessageBoxA (1)
IMPORT-NEXT:     Address: 0x40103A
IMPORT-NEXT:   }
IMPORT-NEXT:   Import {
IMPORT-NEXT:     Symbol: ExitProcess (0)
IMPORT-NEXT:     Address: 0x401044
IMPORT-NEXT:   }
IMPORT-NEXT: }

BASEREL:      BaseReloc [
BASEREL-NEXT:   Entry {
BASEREL-NEXT:     Type: HIGHLOW
BASEREL-NEXT:     Address: 0x1005
BASEREL-NEXT:   }
BASEREL-NEXT:   Entry {
BASEREL-NEXT:     Type: HIGHLOW
BASEREL-NEXT:     Address: 0x100C
BASEREL-NEXT:   }
BASEREL-NEXT:   Entry {
BASEREL-NEXT:     Type: HIGHLOW
BASEREL-NEXT:     Address: 0x101F
BASEREL-NEXT:   }
BASEREL-NEXT:   Entry {
BASEREL-NEXT:     Type: HIGHLOW
BASEREL-NEXT:     Address: 0x1025
BASEREL-NEXT:   }
BASEREL-NEXT:   Entry {
BASEREL-NEXT:     Type: HIGHLOW
BASEREL-NEXT:     Address: 0x102D
BASEREL-NEXT:   }
BASEREL-NEXT:   Entry {
BASEREL-NEXT:     Type: HIGHLOW
BASEREL-NEXT:     Address: 0x103B
BASEREL-NEXT:   }
BASEREL-NEXT:   Entry {
BASEREL-NEXT:     Type: HIGHLOW
BASEREL-NEXT:     Address: 0x1045
BASEREL-NEXT:   }
BASEREL-NEXT:   Entry {
BASEREL-NEXT:     Type: ABSOLUTE
BASEREL-NEXT:     Address: 0x1000
BASEREL-NEXT:   }
BASEREL-NEXT:   Entry {
BASEREL-NEXT:     Type: HIGHLOW
BASEREL-NEXT:     Address: 0x3014
BASEREL-NEXT:   }
BASEREL-NEXT:   Entry {
BASEREL-NEXT:     Type: HIGHLOW
BASEREL-NEXT:     Address: 0x3018
BASEREL-NEXT:   }
BASEREL-NEXT: ]

DISASM:      401029: 51                           	pushl	%ecx
DISASM-NEXT: 40102a: 52                           	pushl	%edx
DISASM-NEXT: 40102b: 50                           	pushl	%eax
DISASM-NEXT: 40102c: 68 18 20 40 00               	pushl	$4202520
DISASM-NEXT: 401031: e8 ca ff ff ff               	calll	0x401000 <.text>
DISASM-NEXT: 401036: 5a                           	popl	%edx
DISASM-NEXT: 401037: 59                           	popl	%ecx
DISASM-NEXT: 401038: ff e0                        	jmpl	*%eax
DISASM-NEXT: 40103a: b8 14 30 40 00               	movl	$4206612, %eax
DISASM-NEXT: 40103f: e9 e5 ff ff ff               	jmp	0x401029 <.text+0x29>
DISASM-NEXT: 401044: b8 18 30 40 00               	movl	$4206616, %eax
DISASM-NEXT: 401049: e9 db ff ff ff               	jmp	0x401029 <.text+0x29>
