# RUN: split-file %s %t
# RUN: llvm-mc -triple=powerpcle-pc-windows -filetype=obj %t/entry.s -o %t/entry.obj
# RUN: llvm-mc -triple=powerpcle-pc-windows -filetype=obj %t/helper.s -o %t/helper.obj
# RUN: yaml2obj %t/glue.yaml -o %t/glue.obj
# RUN: yaml2obj %t/metadata.yaml -o %t/metadata.obj
# RUN: lld-link /machine:ppc /entry:entry /subsystem:native /nodefaultlib /out:%t.exe %t/entry.obj %t/helper.obj %t/glue.obj %t/metadata.obj
# RUN: llvm-readobj --file-headers --sections %t.exe | FileCheck %s --check-prefix=HEADERS
# RUN: llvm-objdump -d --triple=powerpcle-pc-windows --no-show-raw-insn %t.exe | FileCheck %s --check-prefix=DISASM
# RUN: llvm-objdump -s -j .rdata %t.exe | FileCheck %s --check-prefix=RDATA
# RUN: llvm-readobj --hex-dump=.data %t.exe | FileCheck %s --check-prefix=GLUE

# HEADERS:      Format: COFF-PowerPC
# HEADERS:      Machine: IMAGE_FILE_MACHINE_POWERPC (0x1F0)
# HEADERS:      AddressOfEntryPoint: 0x2000
# HEADERS:      Name: .text
# HEADERS:      VirtualAddress: 0x1000
# HEADERS:      Name: .rdata
# HEADERS:      VirtualAddress: 0x2000

# DISASM:       00401000 <.text>:
# DISASM-NEXT:    401000:      bl 0x401008 <.text+0x8>
# DISASM-NEXT:    401004:      b 0x401004 <.text+0x4>
# DISASM-NEXT:    401008:      addi 3, 3, 3
# DISASM-NEXT:    40100c:      blr

# The two eight-byte descriptors contain {code VA, biased TOC VA}.
# RDATA:        Contents of section .rdata:
# RDATA-NEXT:   402000 00104000 00a04000 08104000 00a04000

# IMAGE_REL_PPC_IFGLUE consumes the instruction encoded by its target's
# IMAGE_REL_PPC_IMGLUE record. Modifier bits do not change either record type.
# GLUE:         0x{{0*}}403000 00000060

#--- entry.s
.text
.globl ..entry
..entry:
  bl ..helper
  b .

.section .rdata,"dr"
.globl entry
entry:
  .long ..entry
  .long .toc

#--- helper.s
.text
.globl ..helper
..helper:
  addi 3, 3, 3
  blr

.section .rdata,"dr"
.globl helper
helper:
  .long ..helper
  .long .toc

#--- glue.yaml
--- !COFF
header:
  Machine:         IMAGE_FILE_MACHINE_POWERPC
  Characteristics: []
sections:
  - Name:            .glue
    Characteristics: [ IMAGE_SCN_CNT_CODE, IMAGE_SCN_MEM_EXECUTE, IMAGE_SCN_MEM_READ ]
    Alignment:       4
    SectionData:     00000000
    Relocations:
      - VirtualAddress:  1610612736 # Encoded instruction 0x60000000.
        SymbolName:      glue
        Type:            270 # IMAGE_REL_PPC_IMGLUE | IMAGE_REL_PPC_NEG
  - Name:            .data
    Characteristics: [ IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_READ, IMAGE_SCN_MEM_WRITE ]
    Alignment:       4
    SectionData:     00000000
    Relocations:
      - VirtualAddress:  0
        SymbolName:      glue
        Type:            269 # IMAGE_REL_PPC_IFGLUE | IMAGE_REL_PPC_NEG
symbols:
  - Name:            glue
    Value:           0
    SectionNumber:   1
    SimpleType:      IMAGE_SYM_TYPE_NULL
    ComplexType:     IMAGE_SYM_DTYPE_FUNCTION
    StorageClass:    IMAGE_SYM_CLASS_EXTERNAL
...

#--- metadata.yaml
--- !COFF
header:
  Machine:         IMAGE_FILE_MACHINE_POWERPC
  Characteristics: []
sections:
  - Name:            .text
    Characteristics: [ IMAGE_SCN_CNT_CODE, IMAGE_SCN_MEM_EXECUTE, IMAGE_SCN_MEM_READ ]
    Alignment:       4
    SectionData:     00000000
    Relocations:
      # This standalone IMGLUE value is metadata, not a symbol table index.
      - VirtualAddress:  0
        SymbolTableIndex: 65535
        Type:            14 # IMAGE_REL_PPC_IMGLUE
symbols: []
...
