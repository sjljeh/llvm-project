# RUN: split-file %s %t
# RUN: yaml2obj %t/alpha.yaml -o %t.alpha.obj
# RUN: lld-link /machine:alpha /entry:entry /subsystem:native /nodefaultlib \
# RUN:   /base:0x7ffec000 /out:%t.alpha.exe %t.alpha.obj
# RUN: llvm-readobj --hex-dump=.text %t.alpha.exe | FileCheck %s
# RUN: yaml2obj %t/alpha64.yaml -o %t.alpha64.obj
# RUN: lld-link /machine:alpha64 /entry:entry /subsystem:native /nodefaultlib \
# RUN:   /base:0x7ffec000 /out:%t.alpha64.exe %t.alpha64.obj
# RUN: llvm-readobj --hex-dump=.text %t.alpha64.exe | FileCheck %s

# REFQ3 consumes the signed 32-bit PAIR value 0x00018000 and REFQ2 consumes
# its signed low 16 bits, 0x8000. The PAIR fields are not symbol table indices.
# CHECK: 0x{{0*}}7ffee000 01000000 ff7f0000 00000000

#--- alpha.yaml
--- !COFF
header:
  Machine:         IMAGE_FILE_MACHINE_ALPHA
  Characteristics: []
sections:
  - Name:            .text
    Characteristics: [ IMAGE_SCN_CNT_CODE, IMAGE_SCN_MEM_EXECUTE, IMAGE_SCN_MEM_READ ]
    Alignment:       4
    SectionData:     000000000000000000000000
    Relocations:
      - VirtualAddress:  0
        SymbolName:      target
        Type:            IMAGE_REL_ALPHA_REFQ3
      - VirtualAddress:  0
        SymbolName:      target
        Type:            IMAGE_REL_ALPHA_ABSOLUTE
      - VirtualAddress:  0
        SymbolTableIndex: 98304
        Type:            IMAGE_REL_ALPHA_PAIR
      - VirtualAddress:  4
        SymbolName:      target
        Type:            IMAGE_REL_ALPHA_REFQ2
      - VirtualAddress:  4
        SymbolName:      target
        Type:            IMAGE_REL_ALPHA_ABSOLUTE
      - VirtualAddress:  4
        SymbolTableIndex: 98304
        Type:            IMAGE_REL_ALPHA_PAIR
  - Name:            .data
    Characteristics: [ IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_READ, IMAGE_SCN_MEM_WRITE ]
    Alignment:       4
    SectionData:     00000000
symbols:
  - Name:            entry
    Value:           8
    SectionNumber:   1
    SimpleType:      IMAGE_SYM_TYPE_NULL
    ComplexType:     IMAGE_SYM_DTYPE_FUNCTION
    StorageClass:    IMAGE_SYM_CLASS_EXTERNAL
  - Name:            target
    Value:           0
    SectionNumber:   2
    SimpleType:      IMAGE_SYM_TYPE_NULL
    ComplexType:     IMAGE_SYM_DTYPE_NULL
    StorageClass:    IMAGE_SYM_CLASS_EXTERNAL
...

#--- alpha64.yaml
--- !COFF
header:
  Machine:         IMAGE_FILE_MACHINE_ALPHA64
  Characteristics: []
sections:
  - Name:            .text
    Characteristics: [ IMAGE_SCN_CNT_CODE, IMAGE_SCN_MEM_EXECUTE, IMAGE_SCN_MEM_READ ]
    Alignment:       4
    SectionData:     000000000000000000000000
    Relocations:
      - VirtualAddress:  0
        SymbolName:      target
        Type:            IMAGE_REL_ALPHA_REFQ3
      - VirtualAddress:  0
        SymbolName:      target
        Type:            IMAGE_REL_ALPHA_ABSOLUTE
      - VirtualAddress:  0
        SymbolTableIndex: 98304
        Type:            IMAGE_REL_ALPHA_PAIR
      - VirtualAddress:  4
        SymbolName:      target
        Type:            IMAGE_REL_ALPHA_REFQ2
      - VirtualAddress:  4
        SymbolName:      target
        Type:            IMAGE_REL_ALPHA_ABSOLUTE
      - VirtualAddress:  4
        SymbolTableIndex: 98304
        Type:            IMAGE_REL_ALPHA_PAIR
  - Name:            .data
    Characteristics: [ IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_READ, IMAGE_SCN_MEM_WRITE ]
    Alignment:       4
    SectionData:     00000000
symbols:
  - Name:            entry
    Value:           8
    SectionNumber:   1
    SimpleType:      IMAGE_SYM_TYPE_NULL
    ComplexType:     IMAGE_SYM_DTYPE_FUNCTION
    StorageClass:    IMAGE_SYM_CLASS_EXTERNAL
  - Name:            target
    Value:           0
    SectionNumber:   2
    SimpleType:      IMAGE_SYM_TYPE_NULL
    ComplexType:     IMAGE_SYM_DTYPE_NULL
    StorageClass:    IMAGE_SYM_CLASS_EXTERNAL
...