# INCLUDE:      LineNumberStart: 1
# INCLUDE:      Filename: {{.*}}include-two.inc
# INCLUDE:      LineNumberStart: 2
# INCLUDE:      Filename: {{.*}}include.asm
# INCLUDE:      LineNumberStart: 10
# INCLUDE:      LineNumberStart: 11

# SOURCELINK:      StringId (0x1002) {
