# RUN: llvm-armasm64 -HELP | FileCheck %s --check-prefix=HELP
# RUN: not llvm-armasm64 2>&1 | FileCheck %s --check-prefix=NO-INPUT
# RUN: not llvm-armasm64 -machin 2>&1 | FileCheck %s --check-prefix=UNKNOWN
# RUN: not llvm-armasm64 -machine 2>&1 | FileCheck %s --check-prefix=MISSING
# RUN: not llvm-armasm64 -machine x64 input.asm 2>&1 | FileCheck %s --check-prefix=MACHINE
# RUN: not llvm-armasm64 input.asm output.obj extra.obj 2>&1 | FileCheck %s --check-prefix=POSITIONAL
# RUN: not llvm-armasm64 -o output.obj input.asm extra.obj 2>&1 | FileCheck %s --check-prefix=POSITIONAL
# RUN: echo "-machine ARM64 /nologo missing.asm output.obj" > %t.rsp
# RUN: not llvm-armasm64 -via %t.rsp 2>&1 | FileCheck %s --check-prefix=ACCEPTED
# RUN: echo "-via %t.rsp" > %t.outer.rsp
# RUN: not llvm-armasm64 -via %t.outer.rsp 2>&1 | FileCheck %s --check-prefix=ACCEPTED
# RUN: not llvm-armasm64 /Fooutput.obj /Iinc -pd "COUNT SETA 1" missing.asm 2>&1 | FileCheck %s --check-prefix=ACCEPTED
# RUN: not llvm-armasm64 -errors %t.errors %S/data-errors.asm %t.obj > %t.output 2>&1
# RUN: FileCheck %s --check-prefix=REDIRECTED < %t.errors
# RUN: count 0 < %t.output
# RUN: llvm-armasm64 -e %t.errors %S/basic.asm %t.obj
# RUN: count 0 < %t.errors
# RUN: not llvm-armasm64 -e %t.missing-errors missing.asm %t.obj > %t.output 2>&1
# RUN: FileCheck %s --check-prefix=ACCEPTED < %t.missing-errors
# RUN: count 0 < %t.output
# RUN: not llvm-armasm64 missing.asm %t.obj > %t.stdout 2> %t.stderr
# RUN: FileCheck %s --check-prefix=ACCEPTED < %t.stdout
# RUN: count 0 < %t.stderr
# RUN: not llvm-armasm64 -errors %t.joined-errors -errorsjoined %S/basic.asm %t.obj > %t.output 2>&1
# RUN: FileCheck %s --check-prefix=JOINED < %t.joined-errors
# RUN: count 0 < %t.output
# RUN: not llvm-armasm64 -errors %t.via-errors -via %t.missing.rsp > %t.output 2>&1
# RUN: FileCheck %s --check-prefix=VIA-ERROR < %t.via-errors
# RUN: count 0 < %t.output

# HELP: OVERVIEW: LLVM ARMASM64 Assembler
# HELP: -errors <file>
# HELP: -I <dir>[;<dir>...]
# HELP: -machine <machine>
# HELP: -o <file>
# HELP: -predefine <directive>
# HELP: -via <file>
# NO-INPUT: error: missing input source file
# UNKNOWN: error: unknown argument '-machin'; did you mean '-machine'?
# MISSING: error: missing argument to '-machine'
# MACHINE: error: invalid machine type 'x64'
# POSITIONAL: error: too many positional arguments
# ACCEPTED: error: missing.asm: {{[Nn]o such file or directory|The system cannot find the file specified}}
# REDIRECTED: error: unknown token in expression
# JOINED: error: unknown argument '-errorsjoined'
# VIA-ERROR: error: {{.*}}missing.rsp
