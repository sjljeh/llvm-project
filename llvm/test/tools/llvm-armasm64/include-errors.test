# RUN: not llvm-armasm64 %S/Inputs/include-missing.asm %t.obj 2>&1 | FileCheck %s --check-prefix=MISSING
# RUN: not llvm-armasm64 %S/Inputs/include-no-end.asm %t.obj 2>&1 | FileCheck %s --check-prefix=NO-END
# RUN: llvm-armasm64 %S/Inputs/include-main-no-end.asm %t.obj 2>&1 | FileCheck %s --check-prefix=MAIN-NO-END
# RUN: llvm-armasm64 -errors %t.errors %S/Inputs/include-main-no-end.asm %t.obj > %t.output 2>&1
# RUN: FileCheck %s --check-prefix=MAIN-NO-END < %t.errors
# RUN: count 0 < %t.output
# RUN: llvm-armasm64 -nowarn %S/Inputs/include-main-no-end.asm %t.obj > %t.output 2>&1
# RUN: count 0 < %t.output
# RUN: llvm-armasm64 -ignore 4045 %S/Inputs/include-main-no-end.asm %t.obj > %t.output 2>&1
# RUN: count 0 < %t.output
# RUN: not llvm-armasm64 %S/Inputs/include-invalid.asm %t.obj 2>&1 | FileCheck %s --check-prefix=INVALID
# RUN: not llvm-armasm64 %S/Inputs/include-duplicate.asm %t.obj 2>&1 | FileCheck %s --check-prefix=DUPLICATE

# MISSING: error: {{.*}}include-missing.asm:2: unable to open include file 'does-not-exist.inc'
# NO-END: error: {{.*}}include-missing-end.inc: unexpected end of file; missing END directive
# MAIN-NO-END: warning: {{.*}}include-main-no-end.asm: A4045: missing END directive
# INVALID: include-invalid.inc:1: A2173: syntax error in expression
# DUPLICATE: include-duplicate.inc:2:{{[0-9]+}}: error: symbol 'duplicate' is already defined
